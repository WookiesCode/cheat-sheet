/* dc_cheat.tcss: the site's dark theme (cheat-sheets/styles.css :root tokens) in Textual CSS. */
$bg-base: #0b0e14;
$bg-surface: #111621;
$bg-elevated: #171e2c;
$bg-code: #080b10;
$bg-hover: #1e2738;
$border-subtle: #1f293a;
$border-strong: #2d3b54;
$text-primary: #e6edf3;
$text-secondary: #9aa7b8;
$text-muted: #64748b;
$accent: #38bdf8;
$accent-green: #4ade80;
$accent-amber: #fbbf24;
$accent-red: #f87171;
$accent-purple: #c084fc;

Screen { background: $bg-base; color: $text-primary; layers: base; }

/* ---- header: brand, search, toolbar ---------------------------------- */
#topbar { height: 3; padding: 0 1; background: $bg-base; }
#brand { width: auto; height: 3; content-align: left middle; padding: 0 1 0 0; }
#brand-chip { width: auto; height: 3; border: round $border-strong; color: $accent-green; text-style: bold; padding: 0 1; }
#brand-title { width: auto; height: 3; content-align: left middle; text-style: bold; padding: 0 2 0 1; }
#search { width: 1fr; min-width: 24; height: 3; background: $bg-surface; border: round $border-strong; color: $text-primary; }
#search:focus { border: round $accent; }
.tbtn { width: auto; height: 3; border: round $border-strong; color: $text-primary; padding: 0 1; margin-left: 1; }
.tbtn:hover { background: $bg-hover; }
.tbtn.-danger { border: round #7f1d1d; color: $accent-red; }
Screen.-narrow .tbtn.-wide-only, Screen.-tight .tbtn.-wide-only { display: none; }
/* Under 110 columns the unwired placeholders give way, so Explain stays on screen. */
Screen.-tight .tbtn.-tight-hide { display: none; }

/* ---- nav tabs ---------------------------------------------------------- */
#tabs { height: 3; margin: 0 1; border: round $border-subtle; background: $bg-surface; padding: 0 1; }
.tab { width: auto; height: 1; padding: 0 1; color: $text-secondary; }
.tab:hover { background: $bg-hover; color: $text-primary; }
.tab.-active { background: #0c2a3a; color: $accent; text-style: bold; }

/* ---- rack targets ------------------------------------------------------ */
#targets { height: 1; margin: 1 1 0 1; }
.tgt { width: auto; height: 1; margin-right: 1; padding: 0 1; background: $bg-surface; color: $text-secondary; }
.tgt.-label { background: #0c2a3a; color: $accent; text-style: bold; }
.tgt.-dashed { color: $text-secondary; }

/* ---- body: sidebar + cards -------------------------------------------- */
#body { height: 1fr; margin-top: 1; }
#sidebar { width: 34; padding: 0 1 0 1; scrollbar-size-vertical: 1; }
#suite-head { height: 3; border: round $border-strong; background: $bg-surface; padding: 0 1; }
.side-group { height: 1; color: $text-muted; text-style: bold; margin-top: 1; padding-left: 1; }
.side-item { height: 1; padding-left: 1; color: $text-secondary; }
.side-item:hover { background: $bg-hover; color: $text-primary; }
.side-item.-active { background: #0c2a3a; color: $text-primary; text-style: bold; border-left: outer $accent; }

#main { width: 1fr; padding: 0 1 0 1; scrollbar-size-vertical: 1; }
#cols { height: auto; }
.col { width: 1fr; height: auto; }
Screen.-narrow .col.-second, Screen.-tight .col.-second { display: none; }

/* ---- cards ------------------------------------------------------------- */
.card { height: auto; border: round $border-strong; background: $bg-surface; margin: 0 1 1 0; padding: 0 1 1 1; }
.card-head { height: auto; margin-bottom: 1; }
.chip { width: auto; height: 3; border: round $border-strong; color: $accent; text-style: bold; padding: 0 1; }
.card-titles { width: 1fr; height: auto; padding: 0 0 0 1; }
.card-title { text-style: bold; color: $text-primary; height: auto; }
.card-sub { color: $text-muted; height: auto; }

.desc { color: $text-primary; text-style: bold; height: auto; margin-top: 1; }
.cmdbox { height: auto; background: $bg-code; border: round $border-subtle; padding: 0 1; }
.cmdbox:hover { border: round $border-strong; background: #0d121b; }
.cmdbox:focus { border: round $accent; }
.cmdbox.-danger { border: round #7f1d1d; }
.cmdbox.-danger:focus { border: round $accent-red; }
.details { height: auto; color: $text-secondary; background: $bg-elevated; border-left: outer $accent; padding: 0 1; margin-top: 1; }
.flagrow { height: auto; background: $bg-elevated; margin-top: 1; padding: 0 1; }
.flag { width: auto; max-width: 26; min-width: 6; height: auto; margin-right: 2; color: $accent; text-style: bold; }
.flagdesc { width: 1fr; height: auto; color: $text-secondary; }
.sub { height: auto; padding: 0 1; margin-top: 1; background: $bg-code; }
.sub:hover { background: $bg-hover; }
.sub:focus { background: $bg-hover; border-left: outer $accent; }
.tip { height: auto; margin-top: 1; color: $text-secondary; }

/* ---- pager + footer ---------------------------------------------------- */
#pager { height: 4; margin: 0 1; }
.page { width: 1fr; height: 4; border: round $border-strong; background: $bg-surface; padding: 0 1; }
.page:hover { background: $bg-hover; }
#page-suite { width: 30; margin: 0 1; content-align: center middle; }
#page-next { content-align: right top; }
#hints { height: 1; padding: 0 1; color: $text-muted; background: $bg-surface; }
#tip-text { width: 1fr; }
#keys { width: auto; color: $text-secondary; }

/* ---- Explain a command (the site's .ex-dialog) --------------------------- */
ExplainScreen { align: center middle; background: $bg-base 70%; }
#ex-dialog { width: 92%; max-width: 132; height: 94%; background: $bg-surface; border: round $border-strong; padding: 0 1; }
#ex-head { height: auto; border-bottom: solid $border-subtle; }
#ex-title { width: 1fr; height: auto; }
#ex-close { margin-left: 1; }
.exbtn { width: auto; height: 1; padding: 0 1; color: $accent; background: $bg-elevated; text-style: bold; }
.exbtn:hover { background: $bg-hover; }
.exbtn:focus { background: #0c2a3a; text-style: bold underline; }
#ex-input-wrap { height: auto; margin: 1 0 0 0; border: round $border-strong; background: $bg-code; }
#ex-input-wrap:focus-within { border: round $accent; }
#ex-prompt { width: 2; color: $accent-green; text-style: bold; }
#ex-input { width: 1fr; height: auto; max-height: 8; padding: 0; background: $bg-code; color: $text-primary; }
#ex-result { height: 1fr; margin-top: 1; scrollbar-size-vertical: 1; }

.ex-empty { color: $text-secondary; height: auto; margin-bottom: 1; }
#ex-samples { grid-size: 2; grid-gutter: 1 1; grid-rows: auto; height: auto; }
.ex-sample { height: auto; padding: 0 1; background: $bg-elevated; border: round $border-subtle; }
.ex-sample:hover, .ex-sample:focus { border: round $accent; }

.ex-verdict { height: auto; padding: 0 1; border: round $border-strong; margin-bottom: 1; }
.ex-verdict.-crit { border: round $accent-red; background: #1c1216; }
.ex-verdict.-warn { border: round $accent-amber; background: #1b1810; }
.ex-verdict.-ok { border: round $accent-green; background: #0f1b16; }
.ex-v-title { height: auto; }
.ex-finding { height: auto; padding-left: 2; }
.ex-mark { width: 2; }
.ex-ftext { width: 1fr; height: auto; }
.ex-safe { height: auto; margin: 0 0 0 4; padding: 0 1; background: $bg-code; border: dashed #2f6b46; }
.ex-safe-code { width: 1fr; height: auto; }

#ex-map { height: auto; padding: 0 1; margin-bottom: 1; background: $bg-code; border: round $border-subtle; }

.ex-stage { height: auto; border: round $border-subtle; background: $bg-elevated; }
.ex-stage-head { height: auto; padding: 0 1; background: $bg-surface; border-bottom: solid $border-subtle; }
.ex-stage-name { width: 1fr; height: auto; }
.ex-remote { width: auto; margin-right: 1; }
.ex-row { height: auto; padding: 0 1; }
.ex-tok { height: auto; margin-right: 2; }
.ex-text { width: 1fr; height: auto; }
.ex-src { width: auto; max-width: 30; height: auto; margin-left: 2; color: $text-muted; text-style: bold; }
.ex-op-row { height: 1; padding-left: 2; }
#ex-actions { height: 1; margin-top: 1; }
#ex-actions .exbtn { margin-right: 2; }
